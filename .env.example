# 値は Lovable Cloud / Supabase のダッシュボードから取得して .env にコピーする。
# .env は Git 管理外（.gitignore 済み）。

# --- Supabase（サーバー側） ---
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
# RLS をバイパスする管理キー。ブラウザには絶対に渡さない。
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase（ブラウザ側。VITE_ 付きはバンドルに埋め込まれる公開値） ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- AI検索（Lovable AI Gateway） ---
LOVABLE_API_KEY=

# --- jGrants 定期取り込み ---
# 設定すると x-sync-secret ヘッダー付きの呼び出しだけが間隔制限を無視できる。
# 未設定でも動作するが、その場合はすべての呼び出しが間隔制限の対象になる。
SYNC_SECRET=
